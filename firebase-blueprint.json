{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private authenticated user credential metadata isolated under users/{userId}/private.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "photoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "photoUrl", "createdAt", "updatedAt"]
    },
    "WorkspaceConfig": {
      "title": "WorkspaceConfig",
      "description": "User workspace configuration and sequence counter.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nextCodeNumber": {
          "type": "integer"
        },
        "seedReplaced": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "workspaceName",
        "nextCodeNumber",
        "seedReplaced",
        "createdAt",
        "updatedAt"
      ]
    },
    "StatusItem": {
      "title": "StatusItem",
      "description": "Workflow status column definition arranged by the user.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["backlog", "active", "review", "blocked", "done"]
        },
        "color": {
          "type": "string",
          "enum": ["slate", "blue", "amber", "violet", "rose", "emerald"]
        },
        "wipLimit": {
          "type": "integer"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "order": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "name",
        "category",
        "color",
        "wipLimit",
        "description",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectItem": {
      "title": "ProjectItem",
      "description": "Role or track grouping candidates.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "leadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "key",
        "name",
        "summary",
        "leadId",
        "targetDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "CandidateRecord": {
      "title": "CandidateRecord",
      "description": "Candidate or imported form response row stored privately under user ownership.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "statusId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "order": {
          "type": "integer"
        },
        "priority": {
          "type": "string",
          "enum": ["urgent", "high", "medium", "low"]
        },
        "assigneeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deleted": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 254
        },
        "contactNo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "portfolioUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "currentLocation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "yearsOfExperience": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "designedAiProduct": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "noticePeriod": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "resumeUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "expectedSalary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "readyToRelocateIn": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "statusHistory": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "code",
        "projectId",
        "statusId",
        "order",
        "priority",
        "assigneeId",
        "deleted",
        "timestamp",
        "fullName",
        "email",
        "contactNo",
        "portfolioUrl",
        "currentLocation",
        "yearsOfExperience",
        "designedAiProduct",
        "noticePeriod",
        "resumeUrl",
        "message",
        "expectedSalary",
        "readyToRelocateIn",
        "statusHistory",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicLeadSubmission": {
      "title": "PublicLeadSubmission",
      "description": "Write-only incoming lead submission submitted via the shareable intake form.",
      "type": "object",
      "properties": {
        "targetUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 254
        },
        "contactNo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "portfolioUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "currentLocation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "yearsOfExperience": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "designedAiProduct": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "noticePeriod": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "resumeUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "expectedSalary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "readyToRelocateIn": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "targetUid",
        "id",
        "fullName",
        "email",
        "contactNo",
        "portfolioUrl",
        "currentLocation",
        "yearsOfExperience",
        "designedAiProduct",
        "noticePeriod",
        "resumeUrl",
        "message",
        "expectedSalary",
        "readyToRelocateIn",
        "createdAt"
      ]
    },
    "PublicFormRoute": {
      "title": "PublicFormRoute",
      "description": "Public clean-URL form route mapping (no PII) linking a vanity form slug to its workspace owner UID.",
      "type": "object",
      "properties": {
        "formId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "routePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "formId",
        "ownerUid",
        "routePath",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeadNotification": {
      "title": "LeadNotification",
      "description": "Persistent real-time notification record created when a new lead arrives via the public intake form.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["new_lead"]
        },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "candidateCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "candidateName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidateEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 254
        },
        "experience": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "designedAiProduct": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "type",
        "candidateId",
        "candidateCode",
        "candidateName",
        "candidateEmail",
        "experience",
        "designedAiProduct",
        "title",
        "message",
        "read",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Authenticated user's private profile PII."
    },
    "/users/{userId}/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/WorkspaceConfig" },
      "description": "User workspace configuration and code counter."
    },
    "/users/{userId}/statuses/{statusId}": {
      "schema": { "$ref": "#/entities/StatusItem" },
      "description": "User-arranged workflow status columns."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectItem" },
      "description": "Role / track definitions."
    },
    "/users/{userId}/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/CandidateRecord" },
      "description": "Candidate records and Excel-imported rows."
    },
    "/users/{userId}/leadSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/PublicLeadSubmission" },
      "description": "Write-only incoming submissions from the shareable Lead Intake Form."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/LeadNotification" },
      "description": "Persistent real-time new lead notifications for the workspace owner."
    },
    "/publicForms/{formId}": {
      "schema": { "$ref": "#/entities/PublicFormRoute" },
      "description": "Public vanity slug lookup mapping clean form URLs (e.g. UXDVault/Submit your Application) to workspace owner UID."
    }
  }
}
